{
  "mcpServers": {
    "ftp-server": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-ftp"
      ],
      "env": {
        "FTP_HOST": "${FTP_HOST}",
        "FTP_PORT": "${FTP_PORT}",
        "FTP_PROTOCOL": "${FTP_PROTOCOL}",
        "FTP_USER": "${FTP_USER}",
        "FTP_PASSWORD": "${FTP_PASSWORD}",
        "FTP_SECURE": "${FTP_SECURE}",
        "FTP_TLS_REJECT_UNAUTHORIZED": "${FTP_TLS_REJECT_UNAUTHORIZED}",
        "FTP_PRIVATE_KEY_PATH": "${FTP_PRIVATE_KEY_PATH}",
        "FTP_PASSPHRASE": "${FTP_PASSPHRASE}",
        "FTP_ENCRYPTION_KEY": "${FTP_ENCRYPTION_KEY}",
        "FTP_LOCAL_ROOTS": "${FTP_LOCAL_ROOTS}"
      }
    }
  }
}
